  {
    "name": "contract_example",
    "record": {
      "id": "DEC-EXAMPLE",
      "type": "decision",
      "class": "record",
      "title": "Report delivery schedule",
      "description": "Deliver the report on Tuesdays using only verified data.",
      "scope": "operations",
      "state": "proposed",
      "author": "example-agent/1",
      "events": [],
      "sources": [],
      "authorized_by": [
        "ROLE-EXAMPLE"
      ],
      "alternatives": [
        {
          "id": "A",
          "description": "Delivery on Mondays.",
          "selected": false,
          "reason": "It leaves no day to verify the data of the weekly close."
        },
        {
          "id": "B",
          "description": "Delivery on Tuesdays.",
          "selected": true,
          "reason": "It reserves Monday to verify the data."
        }
      ],
      "criteria": [
        "Availability of verified data",
        "Delivery deadline"
      ],
      "rationale": "It is proposed to reserve one day for verification."
    },
    "body": "<clause id=\"C1\">\nThe report is delivered on Tuesdays.\n</clause>\n\n<clause id=\"C2\">\nThe report only includes verified data.\n</clause>\n",
    "requested_effects": [],
    "bytes": "{\"author\":\"example-agent/1\",\"body\":\"<clause id=\\\"C1\\\">\\nThe report is delivered on Tuesdays.\\n</clause>\\n\\n<clause id=\\\"C2\\\">\\nThe report only includes verified data.\\n</clause>\\n\",\"class\":\"record\",\"description\":\"Deliver the report on Tuesdays using only verified data.\",\"fields\":{\"alternatives\":[{\"description\":\"Delivery on Mondays.\",\"id\":\"A\",\"reason\":\"It leaves no day to verify the data of the weekly close.\",\"selected\":false},{\"description\":\"Delivery on Tuesdays.\",\"id\":\"B\",\"reason\":\"It reserves Monday to verify the data.\",\"selected\":true}],\"authorized_by\":[\"ROLE-EXAMPLE\"],\"criteria\":[\"Availability of verified data\",\"Delivery deadline\"],\"rationale\":\"It is proposed to reserve one day for verification.\",\"sources\":[]},\"id\":\"DEC-EXAMPLE\",\"requested_effects\":[],\"scope\":\"operations\",\"title\":\"Report delivery schedule\",\"type\":\"decision\"}",
    "sha256": "1cc246fde2f9e0abb2aa3fee678aca6fc2d3004b6007e2d013761745c4a03b93"
  },
